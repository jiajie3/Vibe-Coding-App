{
  "id": "tpl_open_drain",
  "version": 9,
  "title": "Open Concrete Drain \u2014 Routine Inspection",
  "published_at": "2026-07-02T08:00:00.000Z",
  "sections": [
    {
      "id": "sec_access",
      "title": "Site & Access"
    },
    {
      "id": "sec_structural",
      "title": "Structural Condition"
    },
    {
      "id": "sec_flow",
      "title": "Flow & Blockage"
    },
    {
      "id": "sec_photos",
      "title": "Photographs"
    }
  ],
  "fields": [
    {
      "id": "site_accessible",
      "section_id": "sec_access",
      "type": "boolean",
      "label": "Was the full stretch accessible?",
      "required": true
    },
    {
      "id": "access_obstruction",
      "section_id": "sec_access",
      "type": "text",
      "label": "Describe the obstruction",
      "help_text": "State the approximate chainage and the nature of the obstruction.",
      "required": true,
      "visible_if": {
        "field": "site_accessible",
        "equals": false
      }
    },
    {
      "id": "structural_condition",
      "section_id": "sec_structural",
      "type": "single_select",
      "label": "Overall structural condition",
      "required": true,
      "options": [
        {
          "value": "good",
          "label": "Good \u2014 no visible defects"
        },
        {
          "value": "fair",
          "label": "Fair \u2014 minor cracking / spalling"
        },
        {
          "value": "poor",
          "label": "Poor \u2014 significant deterioration"
        },
        {
          "value": "critical",
          "label": "Critical \u2014 structural failure risk"
        }
      ],
      "requires_photo_when": {
        "in": [
          "poor",
          "critical"
        ]
      }
    },
    {
      "id": "defect_types",
      "section_id": "sec_structural",
      "type": "multi_select",
      "label": "Defects observed",
      "visible_if": {
        "field": "structural_condition",
        "equals": "poor"
      },
      "options": [
        {
          "value": "cracking",
          "label": "Cracking"
        },
        {
          "value": "spalling",
          "label": "Spalling / exposed rebar"
        },
        {
          "value": "joint_failure",
          "label": "Joint failure"
        },
        {
          "value": "undermining",
          "label": "Undermining / scour"
        },
        {
          "value": "wall_collapse",
          "label": "Wall collapse"
        }
      ]
    },
    {
      "id": "defect_severity",
      "section_id": "sec_structural",
      "type": "severity",
      "label": "Severity grade",
      "help_text": "1 = cosmetic, 5 = immediate intervention required.",
      "min": 1,
      "max": 5,
      "visible_if": {
        "field": "structural_condition",
        "equals": "poor"
      }
    },
    {
      "id": "blockage_present",
      "section_id": "sec_flow",
      "type": "boolean",
      "label": "Blockage or restriction present?",
      "required": true,
      "requires_photo_when": {
        "equals": true
      }
    },
    {
      "id": "blockage_type",
      "section_id": "sec_flow",
      "type": "multi_select",
      "label": "Blockage composition",
      "visible_if": {
        "field": "blockage_present",
        "equals": true
      },
      "options": [
        {
          "value": "silt",
          "label": "Silt / sediment"
        },
        {
          "value": "vegetation",
          "label": "Vegetation"
        },
        {
          "value": "refuse",
          "label": "Refuse / litter"
        },
        {
          "value": "debris",
          "label": "Construction debris"
        },
        {
          "value": "fallen_tree",
          "label": "Fallen tree / large object"
        }
      ]
    },
    {
      "id": "flow_condition",
      "section_id": "sec_flow",
      "type": "single_select",
      "label": "Flow condition at time of inspection",
      "required": true,
      "options": [
        {
          "value": "dry",
          "label": "Dry"
        },
        {
          "value": "free",
          "label": "Free flowing"
        },
        {
          "value": "restricted",
          "label": "Restricted"
        },
        {
          "value": "standing",
          "label": "Standing water"
        },
        {
          "value": "surcharged",
          "label": "Surcharged / overtopping"
        }
      ],
      "requires_photo_when": {
        "in": [
          "surcharged"
        ]
      }
    },
    {
      "id": "general_photos",
      "section_id": "sec_photos",
      "type": "photo",
      "label": "General condition photographs",
      "help_text": "Optional. One at each end of the stretch is good practice.",
      "required": false
    },
    {
      "id": "remarks",
      "section_id": "sec_photos",
      "type": "text",
      "label": "Additional remarks"
    }
  ]
}

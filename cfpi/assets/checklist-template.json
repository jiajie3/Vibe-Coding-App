{
  "id": "tpl_open_drain",
  "version": 14,
  "title": "Open Concrete Drain — Routine Inspection",
  "published_at": "2026-07-02T08:00:00.000Z",
  "sections": [
    {
      "id": "sec_photos",
      "title": "Photographs"
    },
    {
      "id": "sec_access",
      "title": "Site & Access"
    },
    {
      "id": "sec_structural",
      "title": "Structural Condition"
    },
    {
      "id": "sec_blockage",
      "title": "Blockage"
    },
    {
      "id": "sec_flow",
      "title": "Flow"
    },
    {
      "id": "sec_remarks",
      "title": "Remarks"
    }
  ],
  "fields": [
    {
      "id": "general_photos",
      "section_id": "sec_photos",
      "type": "photo",
      "label": "General condition photographs",
      "help_text": "At least one, whatever you found.",
      "required": true,
      "min": 1
    },
    {
      "id": "site_accessible",
      "section_id": "sec_access",
      "type": "boolean",
      "label": "Was the full stretch accessible?",
      "required": true
    },
    {
      "id": "access_reason",
      "section_id": "sec_access",
      "type": "single_select",
      "label": "What stopped you?",
      "required": true,
      "visible_if": {
        "field": "site_accessible",
        "equals": false
      },
      "options": [
        {
          "value": "locked",
          "label": "Locked gate or hoarding"
        },
        {
          "value": "vegetation",
          "label": "Dense vegetation"
        },
        {
          "value": "water",
          "label": "Water too deep to walk"
        },
        {
          "value": "works",
          "label": "Construction works in the way"
        },
        {
          "value": "unsafe",
          "label": "Unsafe footing or structure"
        },
        {
          "value": "private",
          "label": "Private land, no access granted"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
      "id": "access_other",
      "section_id": "sec_access",
      "type": "text",
      "label": "Describe what stopped you",
      "help_text": "State the approximate distance along the drain and what you found.",
      "required": true,
      "visible_if": {
        "field": "access_reason",
        "equals": "other"
      }
    },
    {
      "id": "structural_condition",
      "section_id": "sec_structural",
      "type": "single_select",
      "label": "Overall structural condition",
      "required": true,
      "options": [
        {
          "value": "good",
          "label": "Good — no visible defects"
        },
        {
          "value": "fair",
          "label": "Fair — minor cracking / spalling"
        },
        {
          "value": "poor",
          "label": "Poor — significant deterioration"
        },
        {
          "value": "critical",
          "label": "Critical — structural failure risk"
        }
      ]
    },
    {
      "id": "defect_types",
      "section_id": "sec_structural",
      "type": "multi_select",
      "label": "Defects observed",
      "visible_if": {
        "field": "structural_condition",
        "in": [
          "fair",
          "poor",
          "critical"
        ]
      },
      "options": [
        {
          "value": "cracking",
          "label": "Cracking"
        },
        {
          "value": "spalling",
          "label": "Spalling / exposed rebar"
        },
        {
          "value": "joint_failure",
          "label": "Joint failure"
        },
        {
          "value": "undermining",
          "label": "Undermining / scour"
        },
        {
          "value": "wall_collapse",
          "label": "Wall collapse"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ],
      "required": true
    },
    {
      "id": "defect_other",
      "section_id": "sec_structural",
      "type": "text",
      "label": "Describe the defect",
      "required": true,
      "visible_if": {
        "field": "defect_types",
        "in": [
          "other"
        ]
      }
    },
    {
      "id": "blockage_present",
      "section_id": "sec_blockage",
      "type": "boolean",
      "label": "Blockage or restriction present?",
      "required": true
    },
    {
      "id": "blockage_type",
      "section_id": "sec_blockage",
      "type": "multi_select",
      "label": "Blockage composition",
      "visible_if": {
        "field": "blockage_present",
        "equals": true
      },
      "options": [
        {
          "value": "silt",
          "label": "Silt / sediment"
        },
        {
          "value": "vegetation",
          "label": "Vegetation"
        },
        {
          "value": "refuse",
          "label": "Refuse / litter"
        },
        {
          "value": "debris",
          "label": "Construction debris"
        },
        {
          "value": "fallen_tree",
          "label": "Fallen tree / large object"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ],
      "required": true
    },
    {
      "id": "blockage_other",
      "section_id": "sec_blockage",
      "type": "text",
      "label": "Describe the blockage",
      "required": true,
      "visible_if": {
        "field": "blockage_type",
        "in": [
          "other"
        ]
      }
    },
    {
      "id": "flow_condition",
      "section_id": "sec_flow",
      "type": "single_select",
      "label": "Flow condition at time of inspection",
      "required": true,
      "options": [
        {
          "value": "dry",
          "label": "Dry"
        },
        {
          "value": "free",
          "label": "Free flowing"
        },
        {
          "value": "restricted",
          "label": "Restricted"
        },
        {
          "value": "standing",
          "label": "Standing water"
        },
        {
          "value": "surcharged",
          "label": "Surcharged / overtopping"
        }
      ]
    },
    {
      "id": "remarks",
      "section_id": "sec_remarks",
      "type": "text",
      "label": "Additional remarks"
    }
  ]
}
